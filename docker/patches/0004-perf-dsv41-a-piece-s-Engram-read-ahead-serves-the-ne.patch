From b539c38f460063e562669c186fb677c3a35820ce Mon Sep 17 00:00:00 2001
From: Manrique <125496885+hashd1ve@users.noreply.github.com>
Date: Mon, 19 Oct 2026 13:45:26 +0100
Subject: [PATCH 4/4] perf(dsv41): a piece's Engram read-ahead serves the next
 one; a short prompt runs whole (TF_FILL_FIRST)

Each piece ended with the next chunk's Engram read-ahead joined, and that chunk, finding no read-ahead pending, read
its rows from the drive again: every chunk of a pass in pieces was read twice, and a 31K-token prompt went at ~1,500
tok/s instead of ~2,100. A chunk now takes rows read ahead that ended before it when they cover it, both layers: they
sit in the read-ahead's own buffers, which rounds leave alone (a round's Engram reads use the host's others). A
prompt's fill invalidates what was read ahead for another, so rows never cross prompts at the same positions.

TF_FILL_FIRST=N: the first piece runs N chunks, so a turn's new tokens within it run whole, as before.

Test: a prompt within the first piece runs whole, the decoding stream waiting for it.
---
 zig/src/core/lane_host_test.zig  | 86 ++++++++++++++++++++++++++++++++
 zig/src/core/lanes/engine.zig    |  9 ++--
 zig/src/families/dsv41/model.zig |  8 ++-
 zig/src/native/cuda.zig          |  3 +-
 4 files changed, 100 insertions(+), 6 deletions(-)

diff --git a/zig/src/core/lane_host_test.zig b/zig/src/core/lane_host_test.zig
index 3cb5c219..265ccb14 100644
--- a/zig/src/core/lane_host_test.zig
+++ b/zig/src/core/lane_host_test.zig
@@ -298,3 +298,89 @@ test "a prompt pass in pieces: a decoding stream keeps its rounds between them,
         try history.append(gpa, t);
     }
 }
+
+test "a prompt within the first piece runs whole: the decoding stream waits for it as before" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    const Watch = struct {
+        mutex: std.Io.Mutex = .init,
+        a: usize = 0, // the first request's tokens delivered so far
+        seen: std.ArrayList(usize) = .empty, // that count at each chunk of a prompt pass
+        b: std.ArrayList(u32) = .empty,
+        a_done: bool = false,
+        b_done: bool = false,
+        fn hook(ctx: *anyopaque, _: *lanes.stream.Stream, _: usize) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            w.mutex.lockUncancelable(std.testing.io);
+            defer w.mutex.unlock(std.testing.io);
+            w.seen.append(gpa, w.a) catch {};
+        }
+        fn event(ctx: *anyopaque, id: Id, e: *const Event) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            w.mutex.lockUncancelable(std.testing.io);
+            defer w.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .tokens => |t| if (id == 1) {
+                    w.a += t.len;
+                } else w.b.appendSlice(gpa, t) catch {},
+                .finished => if (id == 1) {
+                    w.a_done = true;
+                } else {
+                    w.b_done = true;
+                },
+                else => {},
+            }
+        }
+        fn until(w: *@This(), comptime what: enum { a_decodes, b_done, a_done }) !void {
+            for (0..20000) |_| {
+                w.mutex.lockUncancelable(std.testing.io);
+                const ok = switch (what) {
+                    .a_decodes => w.a > 0,
+                    .b_done => w.b_done,
+                    .a_done => w.a_done,
+                };
+                w.mutex.unlock(std.testing.io);
+                if (ok) return;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+            return error.Timeout;
+        }
+    };
+    var w: Watch = .{};
+    defer w.seen.deinit(gpa);
+    defer w.b.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .prefill_chunks = 6, .prefill_hook = Watch.hook, .prefill_hook_ctx = &w };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    core.fill_chunks = 1;
+    core.fill_rounds = 2;
+    core.fill_first = 6; // the whole six-chunk prompt fits the first piece
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    try host.start();
+    defer host.stop();
+    const e = host.engine();
+    const pa = [_]u32{ 2, 7, 1, 8 };
+    const pb = [_]u32{ 3, 1, 4, 1, 5 };
+    try e.submit(1, &.{ .prompt = &pa, .max_tokens = 1_000_000 }, .{ .ctx = &w, .event = Watch.event });
+    try w.until(.a_decodes);
+    try e.submit(2, &.{ .prompt = &pb, .max_tokens = 8 }, .{ .ctx = &w, .event = Watch.event });
+    try w.until(.b_done);
+    e.cancel(1);
+    try w.until(.a_done);
+    // both passes ran whole: the first stream delivered nothing while the second's six chunks ran
+    try std.testing.expectEqual(@as(usize, 12), w.seen.items.len);
+    for (w.seen.items[0..6]) |n| try std.testing.expectEqual(@as(usize, 0), n);
+    for (w.seen.items[7..12]) |n| try std.testing.expectEqual(w.seen.items[6], n);
+    // the second reply is the fake's own continuation of its prompt
+    var history: std.ArrayList(u32) = .empty;
+    defer history.deinit(gpa);
+    try history.appendSlice(gpa, &pb);
+    try std.testing.expectEqual(@as(usize, 8), w.b.items.len);
+    for (w.b.items) |t| {
+        try std.testing.expectEqual(lanes.fake.next(history.items, null, history.items.len), t);
+        try history.append(gpa, t);
+    }
+}
diff --git a/zig/src/core/lanes/engine.zig b/zig/src/core/lanes/engine.zig
index 765afee5..b439d222 100644
--- a/zig/src/core/lanes/engine.zig
+++ b/zig/src/core/lanes/engine.zig
@@ -41,6 +41,7 @@ pub const Engine = struct {
     filling: ?*Stream = null, // a stream whose prompt pass runs in pieces between the others' rounds (not live yet)
     fill_chunks: u32 = 0, // a piece's chunks (backend prefill_part; 0: a prompt pass runs whole inside addStream)
     fill_rounds: u32 = 4, // the live streams' rounds between two pieces
+    fill_first: u32 = 0, // the first piece's chunks (0: fill_chunks): a short prompt then runs whole
     rounds_since: u32 = 0,
 
     pub fn init(gpa: Allocator, cfg: *const Config, backend: be.Backend, clock: be.Clock) Engine {
@@ -87,7 +88,7 @@ pub const Engine = struct {
         try trail.event(e, &.{ f("ev", str("add")), f("stream", str(s.id)) });
         if (e.filling != null) return error.FillBusy;
         if (e.fill_chunks > 0 and e.backend.vtable.prefill_part != null and e.activeCount() > 0) {
-            if (!try e.piece(s)) {
+            if (!try e.piece(s, if (e.fill_first > 0) e.fill_first else e.fill_chunks)) {
                 e.filling = s;
                 e.rounds_since = 0;
                 return;
@@ -99,8 +100,8 @@ pub const Engine = struct {
         try e.started(s);
     }
 
-    fn piece(e: *Engine, s: *Stream) !bool {
-        return e.backend.vtable.prefill_part.?(e.backend.ptr, s, e.fill_chunks) catch |err| {
+    fn piece(e: *Engine, s: *Stream, chunks: u32) !bool {
+        return e.backend.vtable.prefill_part.?(e.backend.ptr, s, chunks) catch |err| {
             if (err == error.Cancelled) e.backend.release(s);
             return err;
         };
@@ -113,7 +114,7 @@ pub const Engine = struct {
         if (e.activeCount() > 0 and e.rounds_since < e.fill_rounds) return false;
         _ = e.arena.reset(.retain_capacity);
         e.rounds_since = 0;
-        const done = e.piece(s) catch |err| {
+        const done = e.piece(s, e.fill_chunks) catch |err| {
             e.filling = null;
             return err;
         };
diff --git a/zig/src/families/dsv41/model.zig b/zig/src/families/dsv41/model.zig
index f88cbc1b..196111af 100644
--- a/zig/src/families/dsv41/model.zig
+++ b/zig/src/families/dsv41/model.zig
@@ -537,6 +537,10 @@ pub const Model = struct {
 
     pub fn fillBegin(m: *Model, slot: usize, base: usize) !void {
         if (slot >= m.streams) return error.BadSlot;
+        if (m.eh) |*eh| { // rows read ahead for another prompt are not this one's, even at the same positions
+            eh.ahead_start = std.math.maxInt(usize);
+            eh.ahead_ready = .{ false, false };
+        }
         m.spans.clearRetainingCapacity();
         m.ch.spans = &.{};
         m.view = try m.caches.view(&m.eng, slot, base);
@@ -577,7 +581,9 @@ pub const Model = struct {
                 ahead.?.join();
                 ahead = null;
             }
-            if (ahead == null) {
+            // rows read ahead that ended before a round or a piece's end are this chunk's when they cover it, both layers
+            const whole = eh.ahead_start == start and eh.ahead_n == n and eh.ahead_err == null and eh.ahead_ready[0] and (c.engram_layers.slice().len < 2 or eh.ahead_ready[1]);
+            if (ahead == null and !whole) {
                 eh.ahead_start = start;
                 eh.ahead_n = n;
                 eh.ahead_ready = .{ false, false };
