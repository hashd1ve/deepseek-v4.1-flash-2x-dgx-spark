index 8503b89e..9148bc71 100644
--- a/zig/kernels/cuda/dsv41_ops.cu
+++ b/zig/kernels/cuda/dsv41_ops.cu
@@ -511,3 +511,59 @@ extern "C" __global__ void tf_ds_vspan_kernel(const unsigned char* types, const
