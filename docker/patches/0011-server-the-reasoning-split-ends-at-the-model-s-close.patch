+        const rest = text[m.open.len..];
+        const trimmed = trimNewlines(rest);
+        shift = m.open.len + (rest.len - trimmed.len);
+        text = trimmed;
     } else if (std.mem.startsWith(u8, text, think_open)) {
-        text = trimNewlines(text[think_open.len..]);
