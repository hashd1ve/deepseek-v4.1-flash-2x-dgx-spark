+        for (calls) |c| if (std.mem.startsWith(u8, text[at_call..], c[0]) and find(text[at_call..], c[1]) != null)
+            return .{ .reasoning = text[0..at_call], .answer = text[at_call..] };
         return .{ .reasoning = text, .answer = "" };
