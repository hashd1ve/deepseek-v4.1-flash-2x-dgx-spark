From 7c00a56c2009b5233ce2a4b6fff717a359d12160 Mon Sep 17 00:00:00 2001
From: hashd1ve <125496885+hashd1ve@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:29:01 +0100
Subject: [PATCH] feat(server): DeepSeek-V4.1's DSML calls stream their
 arguments as they are written

A DSML calls block was held until the reply ended, so a long call (an agent
writing a file) showed nothing for as long as it took: ~4 min still on one
token in one session. The streamer now reads the block as
tool_parse.dsml41Calls does and sends each invoke's opening delta once its
name is whole, a string value's text as it is written, and a JSON value at
its closer. The joined arguments are the parsed call's (tested a character
at a time), and a call the reply's length cuts off stays open, as a
streamed XML call does.
---
 zig/src/server/chat.zig        |   1 +
 zig/src/server/tool_parse.zig  |  12 +-
 zig/src/server/tool_stream.zig | 259 +++++++++++++++++++++++++++++++--
 3 files changed, 254 insertions(+), 18 deletions(-)

diff --git a/zig/src/server/chat.zig b/zig/src/server/chat.zig
index 2fefa0e5..64b25efc 100644
--- a/zig/src/server/chat.zig
+++ b/zig/src/server/chat.zig
@@ -402,6 +402,7 @@ const Generation = struct {
         if (g.calls) |*c| {
             var out: std.ArrayList(Value) = .empty;
             try c.feed(tool_parse.beforeDsml(answer), &out); // never the reasoning, nor a DSML block's arguments: a call they quote is not made
+            try c.feedDsml(answer, &out); // the DSML calls themselves, their arguments as they are written
             for (out.items) |d| try g.emit(sink, d);
         }
     }
